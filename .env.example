# ── Silvestar platform environment ─────────────────────────────
# Everything optional: absent values fall back to embedded engines
# and the keyless AI chain. Fill in for production-grade behavior.

# Required for the Vault (AES key derivation) in production
SILVESTAR_SECRET=change-me-in-prod

# Real infrastructure (absent = embedded SQLite/memory fallbacks)
DATABASE_URL=postgresql://silvestar:pass@host:5432/silvestar
REDIS_URL=redis://host:6379/0
NEO4J_URL=bolt://host:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pass

# Silvestar AI — keyless chain works out of the box; set these for OpenRouter/OpenAI
# Example (OpenRouter): AI_PRIMARY_URL=https://openrouter.ai/api/v1/chat/completions
#                       AI_MODEL=nex-agi/nex-n2.5-mini:free
AI_API_KEY=
AI_PRIMARY_URL=https://text.pollinations.ai/openai
AI_MODEL=openai
AI_FAILOVER_MODELS=nvidia/nemotron-3.5-lightning:free,z-ai/glm-5.2:free

# WebRTC A/V rooms (WebSocket chat works without these)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Frontend → API base (baked into the Next build)
NEXT_PUBLIC_API_URL=http://localhost:8000
